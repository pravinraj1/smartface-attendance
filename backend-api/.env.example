# ============================================================
# SmartFace Attendance - Backend Environment Variables
# ============================================================
# Copy this to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY_HERE

# Security (generate a strong random value for production)
SECRET_KEY=your-secret-key-min-32-chars

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin bootstrap (used only to seed the initial admin user on first run)
ADMIN_EMAIL=admin@smartface.com
ADMIN_INITIAL_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Storage
STORAGE_PATH=./storage

# Face Recognition
FACE_MATCH_THRESHOLD=0.75
ATTENDANCE_COOLDOWN_MINUTES=5

# Work Schedule
CHECKIN_START_TIME=08:00
LATE_AFTER_TIME=09:15
AUTO_CHECKOUT_TIME=22:00
